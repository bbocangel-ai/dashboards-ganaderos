---
import Layout from '../layouts/Layout.astro';
import { aggPartidarios, fmtNum, fmtFecha, fmtBs } from '../lib/data';

const partidarios = aggPartidarios();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const totalCab = partidarios.reduce((s, p) => s + p.cabezas_efectivas, 0);
const totalSg  = partidarios.reduce((s, p) => s + p.cabezas_sisgado, 0);
const totalGan = partidarios.reduce((s, p) => s + p.kg_totales_ganados, 0);

const catColor: Record<string, string> = {
  VQ: 'bg-pink-100 text-pink-800',
  TL: 'bg-sky-100 text-sky-800',
  TO: 'bg-indigo-100 text-indigo-800',
  TR: 'bg-amber-100 text-amber-800',
  TA: 'bg-amber-100 text-amber-800',
  NV: 'bg-violet-100 text-violet-800',
};
---
<Layout title="Partidarios">
  <div class="flex items-end justify-between mb-6">
    <div>
      <h2 class="text-lg font-semibold text-stone-900">Partidarios / Inversionistas</h2>
      <p class="text-sm text-stone-500">Cada compra (línea de RACAS) detallada por categoría y mes — totales rolled up por inversionista</p>
    </div>
    <div class="text-right text-xs text-stone-500">
      {fmtNum(totalCab)} cabezas (efectivas) · {fmtNum(totalSg)} en SisGado · {fmtNum(totalGan)} kg ganados
    </div>
  </div>

  <div class="space-y-8">
    {partidarios.map(p => {
      const tieneOverride = p.cabezas_efectivas !== p.cabezas_sisgado;
      return (
      <section class="card">
        <header class="px-5 py-4 border-b border-stone-200 flex items-center justify-between">
          <div>
            <h3 class="text-base font-bold text-stone-900">{p.nombre}</h3>
            <p class="text-xs text-stone-500">
              {p.id} · {p.compras.length} compra{p.compras.length === 1 ? '' : 's'} · ingresó por primera vez el {fmtFecha(p.ingreso_fecha_min) || '—'}
            </p>
          </div>
          <div class="text-right">
            <div class="text-2xl font-bold text-stone-900">{fmtNum(p.cabezas_efectivas)}</div>
            <div class="text-xs text-stone-500">
              cabezas total
              {tieneOverride && (
                <span class="ml-1 text-amber-600">(SisGado: {fmtNum(p.cabezas_sisgado)})</span>
              )}
            </div>
          </div>
        </header>

        <div class="overflow-x-auto">
          <table class="tbl">
            <thead>
              <tr>
                <th>Compra</th>
                <th>Mes</th>
                <th>Categoría</th>
                <th>Origen</th>
                <th class="num">Cab. real</th>
                <th class="num">Cab. SisGado</th>
                <th class="num">Bs/cab</th>
                <th class="num">Peso ing.</th>
                <th class="num">Peso act.</th>
                <th class="num">Ganancia</th>
                <th class="num">GMD</th>
                <th class="num">Días</th>
                <th class="num">Vendidas</th>
              </tr>
            </thead>
            <tbody>
              {p.compras.map(c => {
                const overOk = c.cabezas_real != null;
                const realMayor = overOk && c.cabezas_real! > c.cabezas_sisgado;
                const realMenor = overOk && c.cabezas_real! < c.cabezas_sisgado;
                return (
                <tr class="clickable" onclick={`location.href='${base}/compras/${encodeURIComponent(c.raza_codigo)}'`}>
                  <td class="font-mono text-xs">
                    <a href={base + '/compras/' + encodeURIComponent(c.raza_codigo)} class="block hover:text-brand-700">
                      <div class="font-bold text-stone-900">{c.raza_codigo}</div>
                      <div class="text-stone-400">{c.raza_descripcion}</div>
                    </a>
                  </td>
                  <td class="text-xs">{c.mes || '—'}</td>
                  <td>
                    <span class={'pill ' + (catColor[c.categoria || ''] || 'bg-stone-100 text-stone-700')}>
                      {c.categoria || '—'}
                    </span>
                  </td>
                  <td class="text-xs text-stone-600 max-w-xs truncate" title={c.origenes.join(', ')}>
                    {c.origenes.length > 0 ? c.origenes.slice(0, 2).join(', ') : '—'}
                    {c.origenes.length > 2 && <span class="text-stone-400"> +{c.origenes.length - 2}</span>}
                  </td>
                  <td class="num font-semibold">
                    {overOk ? fmtNum(c.cabezas_real!) : fmtNum(c.cabezas_sisgado)}
                    {realMayor && <span class="ml-1 text-[10px] text-emerald-700 uppercase font-bold" title={c.override_nota || 'Más cabezas reales que en SisGado (chips caídos / sin identificar)'}>+{c.cabezas_real! - c.cabezas_sisgado}</span>}
                    {realMenor && <span class="ml-1 text-[10px] text-rose-700 uppercase font-bold" title={c.override_nota || ''}>−{c.cabezas_sisgado - c.cabezas_real!}</span>}
                  </td>
                  <td class="num">
                    <span class={realMayor || realMenor ? 'text-amber-600' : 'text-stone-500'}>{fmtNum(c.cabezas_sisgado)}</span>
                  </td>
                  <td class="num">{c.precio_compra_bs_prom != null ? fmtBs(c.precio_compra_bs_prom) : '—'}</td>
                  <td class="num">{fmtNum(c.peso_ingreso_prom, 1)} kg</td>
                  <td class="num">{fmtNum(c.peso_actual_prom, 1)} kg</td>
                  <td class="num">
                    <span class={c.ganancia_kg_prom >= 0 ? 'text-emerald-700 font-medium' : 'text-rose-700 font-medium'}>
                      {c.ganancia_kg_prom >= 0 ? '+' : ''}{fmtNum(c.ganancia_kg_prom, 1)} kg
                    </span>
                  </td>
                  <td class="num">{c.gmd_prom != null ? fmtNum(c.gmd_prom, 3) : '—'}</td>
                  <td class="num text-stone-500">{c.dias_prom > 0 ? c.dias_prom + ' d' : '—'}</td>
                  <td class="num">
                    {c.vendidos > 0 ? (
                      <span class="text-emerald-700 font-medium">{c.vendidos}</span>
                    ) : '—'}
                    {c.activos > 0 && c.vendidos > 0 && (
                      <span class="text-stone-400 text-xs"> / {c.activos} act.</span>
                    )}
                  </td>
                </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    )})}
  </div>

  <div class="mt-6 card p-5 bg-stone-50/50 border-stone-200">
    <h4 class="text-sm font-semibold text-stone-900 mb-2">¿La cantidad real no coincide con SisGado?</h4>
    <p class="text-sm text-stone-600 mb-3">
      Es normal — chips caídos, animales sin identificar, errores de carga. La cantidad real puede ser <strong>mayor o menor</strong> que la de SisGado.
      Para sobreescribirla, editá <code>src/data/overrides.json</code> usando el código de RACAS:
    </p>
    <pre class="bg-white rounded-lg p-3 text-xs font-mono text-stone-800 border border-stone-200 overflow-x-auto"><code>{`{
  "compras": {
    "06": { "cabezas_real": 28, "nota": "se cayó un chip, recuperado" },
    "BB": { "cabezas_real": 25, "nota": "real conteo del corral 06/05" }
  }
}`}</code></pre>
    <p class="text-xs text-stone-500 mt-3">
      Después corré <code>actualizar.cmd</code> (o solo <code>npm run build &amp;&amp; git push</code>).
      <span class="ml-2"><span class="text-emerald-700 font-semibold">+N</span> = más reales que SisGado · <span class="text-rose-700 font-semibold">−N</span> = menos reales</span>
    </p>
  </div>
</Layout>
