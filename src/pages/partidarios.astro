---
import Layout from '../layouts/Layout.astro';
import Kpi from '../components/Kpi.astro';
import { aggPartidarios, fmtNum } from '../lib/data';

const lista = aggPartidarios();
const totalCab = lista.reduce((s, p) => s + p.cabezas, 0);
const totalGan = lista.reduce((s, p) => s + p.kg_totales_ganados, 0);

// Categorias presentes (para columnas dinámicas)
const cats = Array.from(new Set(lista.flatMap(p => Object.keys(p.por_categoria)))).sort();
---
<Layout title="Partidarios">
  <div class="flex items-end justify-between mb-6">
    <div>
      <h2 class="text-lg font-semibold text-stone-900">Partidarios / Inversionistas</h2>
      <p class="text-sm text-stone-500">BB · DB · MB · MA · FB — desempeño por inversionista</p>
    </div>
    <div class="text-right text-xs text-stone-500">
      {fmtNum(totalCab)} cabezas · {fmtNum(totalGan)} kg ganados en total
    </div>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-8">
    {lista.map(p => (
      <div class="kpi">
        <div class="kpi-label">{p.id} · {p.nombre}</div>
        <div class="kpi-value">{fmtNum(p.cabezas)}</div>
        <div class="kpi-sub">cab · GMD {p.gmd_prom != null ? fmtNum(p.gmd_prom, 3) : '—'} · gan {fmtNum(p.ganancia_kg_prom, 1)} kg/cab</div>
      </div>
    ))}
  </div>

  <div class="table-wrap mb-6">
    <div class="px-5 py-3 border-b border-stone-200">
      <h3 class="font-semibold text-stone-900">Resumen por partidario</h3>
    </div>
    <table class="tbl">
      <thead>
        <tr>
          <th>Partidario</th>
          <th class="num">Cabezas</th>
          <th class="num">Peso ing.</th>
          <th class="num">Peso act.</th>
          <th class="num">Ganancia / cab</th>
          <th class="num">GMD</th>
          <th class="num">Kg ganados (total)</th>
        </tr>
      </thead>
      <tbody>
        {lista.map(p => (
          <tr>
            <td>
              <div class="font-medium text-stone-900">{p.id}</div>
              <div class="text-xs text-stone-500">{p.nombre}</div>
            </td>
            <td class="num font-semibold">{fmtNum(p.cabezas)}</td>
            <td class="num">{fmtNum(p.peso_ingreso_prom, 1)} kg</td>
            <td class="num">{fmtNum(p.peso_actual_prom, 1)} kg</td>
            <td class="num">
              <span class={p.ganancia_kg_prom >= 0 ? 'text-emerald-700 font-medium' : 'text-rose-700 font-medium'}>
                {p.ganancia_kg_prom >= 0 ? '+' : ''}{fmtNum(p.ganancia_kg_prom, 1)} kg
              </span>
            </td>
            <td class="num">{p.gmd_prom != null ? fmtNum(p.gmd_prom, 3) : '—'}</td>
            <td class="num">{fmtNum(p.kg_totales_ganados)} kg</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="table-wrap">
    <div class="px-5 py-3 border-b border-stone-200">
      <h3 class="font-semibold text-stone-900">Distribución por categoría</h3>
    </div>
    <table class="tbl">
      <thead>
        <tr>
          <th>Partidario</th>
          {cats.map(c => <th class="num">{c}</th>)}
          <th class="num">Total</th>
        </tr>
      </thead>
      <tbody>
        {lista.map(p => (
          <tr>
            <td class="font-medium">{p.id}</td>
            {cats.map(c => (
              <td class="num">{p.por_categoria[c] ? fmtNum(p.por_categoria[c]) : '—'}</td>
            ))}
            <td class="num font-semibold">{fmtNum(p.cabezas)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Layout>
