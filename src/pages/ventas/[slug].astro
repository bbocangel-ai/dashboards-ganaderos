---
import Layout from '../../layouts/Layout.astro';
import Kpi from '../../components/Kpi.astro';
import { sesiones, fmtNum, fmtFecha, fmtBs, type GroupRow } from '../../lib/data';
import { DESBASTE, PRECIO_VENTA_BS_KG, USD_RATE } from '../../lib/config';

export async function getStaticPaths() {
  return sesiones
    .filter(s => ['VT', 'VTA', 'VNT'].includes(s.trabajo_tipo || ''))
    .map(s => ({ params: { slug: s.slug }, props: { sesion: s } }));
}

const { sesion } = Astro.props;
const precio = sesion.precio_venta_bs_kg ?? PRECIO_VENTA_BS_KG;
const precioEstimado = sesion.precio_venta_bs_kg == null;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function ingresoBs(g: GroupRow) {
  return Math.round(g.peso_neto_total * precio);
}

const peso_bruto_total = (sesion.peso_prom || 0) * sesion.n;
const peso_neto_total = peso_bruto_total * (1 - DESBASTE);
const ingreso_total_bs = peso_neto_total * precio;
---
<Layout title={`Venta · ${fmtFecha(sesion.fecha_max)}`}>
  <div class="mb-6">
    <a href={base + '/ventas'} class="text-xs text-brand-600 hover:underline">← Volver a Ventas</a>
    <h2 class="mt-2 text-lg font-semibold text-stone-900">
      <span class="pill bg-emerald-100 text-emerald-800 mr-2">{sesion.trabajo_tipo}</span>
      {sesion.trabajo_detalle}
    </h2>
    <p class="text-sm text-stone-500">{fmtFecha(sesion.fecha_max)} · {sesion.sesion}</p>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
    <Kpi label="Cabezas" value={fmtNum(sesion.n)} sub="en esta venta" />
    <Kpi label="Peso prom" value={(sesion.peso_prom != null ? fmtNum(sesion.peso_prom, 1) : '—') + ' kg'} sub={`bruto · neto ${fmtNum((sesion.peso_prom||0) * (1-DESBASTE), 1)} kg (−${Math.round(DESBASTE*100)}%)`} />
    <Kpi label="Bs/kg" value={sesion.split ? 'split' : fmtNum(precio, 1) + (precioEstimado ? ' (est)' : '')} sub={sesion.split ? 'distintos por comprador' : (precioEstimado ? 'estimado · agregá Bs/kg al nombre del LOTE' : 'real')} />
    <Kpi label="Ingreso bruto" value={sesion.split ? fmtBs(sesion.split.destinos.reduce((s,d) => s + d.ingreso_bs, 0)) : fmtBs(Math.round(ingreso_total_bs))} sub={`USD ${fmtNum(Math.round((sesion.split ? sesion.split.destinos.reduce((s,d) => s + d.ingreso_bs, 0) : ingreso_total_bs) / USD_RATE))}`} />
  </div>

  {sesion.split && (
    <section class="mb-6">
      <h3 class="section-title">Compradores</h3>
      <div class="grid md:grid-cols-2 gap-4 mb-2">
        {sesion.split.destinos.map(d => (
          <div class="card p-5">
            <div class="flex items-center justify-between mb-3">
              <h4 class="font-bold text-stone-900 text-base">{d.comprador}</h4>
              <span class="text-xs text-stone-500 font-mono">{fmtFecha(d.fecha)}</span>
            </div>
            <div class="grid grid-cols-2 gap-y-3 gap-x-4 text-sm">
              <div>
                <div class="kpi-label">Cantidad</div>
                <div class="text-2xl font-bold tabular-nums">{fmtNum(d.cabezas)} <span class="text-sm font-normal text-stone-500">cab</span></div>
              </div>
              <div>
                <div class="kpi-label">Bs/kg</div>
                <div class="text-2xl font-bold tabular-nums">{d.bs_kg != null ? fmtNum(d.bs_kg, 1) : '—'}</div>
              </div>
              <div>
                <div class="kpi-label">Peso bruto / cab</div>
                <div class="text-base font-semibold tabular-nums">{fmtNum(d.peso_prom_bruto, 0)} kg</div>
                <div class="text-xs text-stone-500">total {fmtNum(d.peso_total_bruto)} kg</div>
              </div>
              <div>
                <div class="kpi-label">Peso neto / cab (−{Math.round(DESBASTE*100)}%)</div>
                <div class="text-base font-semibold tabular-nums">{fmtNum(d.peso_prom_neto, 0)} kg</div>
                <div class="text-xs text-stone-500">total {fmtNum(d.peso_total_neto)} kg</div>
              </div>
            </div>
            <div class="mt-4 pt-3 border-t border-stone-100">
              <div class="kpi-label">Ingreso bruto</div>
              <div class="flex items-baseline gap-2">
                <span class="text-2xl font-bold tabular-nums text-stone-900">{fmtBs(d.ingreso_bs)}</span>
                <span class="text-sm text-stone-500 tabular-nums">USD {fmtNum(Math.round(d.ingreso_bs / USD_RATE))}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Por partidario -->
  <section class="mb-6">
    <h3 class="text-sm font-semibold text-stone-900 mb-2">Por partidario</h3>
    <div class="table-wrap">
      <table class="tbl">
        <thead>
          <tr>
            <th>Partidario</th>
            <th class="num">Cab</th>
            <th class="num">Peso prom</th>
            <th class="num">Peso ingreso</th>
            <th class="num">Ganancia / cab</th>
            <th class="num">Días</th>
            <th class="num">Peso neto total</th>
            <th class="num">Ingreso Bs</th>
          </tr>
        </thead>
        <tbody>
          {sesion.por_partidario.length === 0 && (
            <tr><td colspan="8" class="text-center text-stone-400 py-6 text-sm">Ningún animal partidario en esta venta</td></tr>
          )}
          {sesion.por_partidario.map(g => (
            <tr>
              <td>
                <div class="font-medium text-stone-900">{g.label}</div>
                <div class="text-xs text-stone-500">{g.key}</div>
              </td>
              <td class="num font-semibold">{fmtNum(g.cabezas)}</td>
              <td class="num">{fmtNum(g.peso_prom, 1)} kg</td>
              <td class="num text-stone-500">{fmtNum(g.peso_ingreso_prom, 1)} kg</td>
              <td class="num">
                <span class={g.ganancia_kg_prom >= 0 ? 'text-emerald-700 font-medium' : 'text-rose-700 font-medium'}>
                  {g.ganancia_kg_prom >= 0 ? '+' : ''}{fmtNum(g.ganancia_kg_prom, 1)} kg
                </span>
              </td>
              <td class="num text-stone-500">{g.dias_prom} d</td>
              <td class="num">{fmtNum(g.peso_neto_total)} kg</td>
              <td class="num font-medium">{fmtBs(ingresoBs(g))}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Por proveedor -->
  <section class="mb-6">
    <h3 class="text-sm font-semibold text-stone-900 mb-2">Por proveedor (origen)</h3>
    <div class="table-wrap">
      <table class="tbl">
        <thead>
          <tr>
            <th>Proveedor</th>
            <th class="num">Cab</th>
            <th class="num">Peso prom</th>
            <th class="num">Peso ingreso</th>
            <th class="num">Ganancia / cab</th>
            <th class="num">Días</th>
            <th class="num">Peso neto total</th>
            <th class="num">Ingreso Bs</th>
          </tr>
        </thead>
        <tbody>
          {sesion.por_proveedor.map(g => (
            <tr>
              <td class="font-medium text-stone-900 max-w-xs truncate">{g.label}</td>
              <td class="num font-semibold">{fmtNum(g.cabezas)}</td>
              <td class="num">{fmtNum(g.peso_prom, 1)} kg</td>
              <td class="num text-stone-500">{fmtNum(g.peso_ingreso_prom, 1)} kg</td>
              <td class="num">
                <span class={g.ganancia_kg_prom >= 0 ? 'text-emerald-700 font-medium' : 'text-rose-700 font-medium'}>
                  {g.ganancia_kg_prom >= 0 ? '+' : ''}{fmtNum(g.ganancia_kg_prom, 1)} kg
                </span>
              </td>
              <td class="num text-stone-500">{g.dias_prom} d</td>
              <td class="num">{fmtNum(g.peso_neto_total)} kg</td>
              <td class="num font-medium">{fmtBs(ingresoBs(g))}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Por categoria -->
  <section>
    <h3 class="text-sm font-semibold text-stone-900 mb-2">Por categoría</h3>
    <div class="table-wrap">
      <table class="tbl">
        <thead>
          <tr>
            <th>Categoría</th>
            <th class="num">Cab</th>
            <th class="num">Peso prom</th>
            <th class="num">Peso neto total</th>
            <th class="num">Ingreso Bs</th>
          </tr>
        </thead>
        <tbody>
          {sesion.por_categoria.map(g => (
            <tr>
              <td class="font-medium text-stone-900">{g.label}</td>
              <td class="num font-semibold">{fmtNum(g.cabezas)}</td>
              <td class="num">{fmtNum(g.peso_prom, 1)} kg</td>
              <td class="num">{fmtNum(g.peso_neto_total)} kg</td>
              <td class="num font-medium">{fmtBs(ingresoBs(g))}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Layout>
