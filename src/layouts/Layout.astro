---
import '../styles/global.css';
import { meta } from '../lib/data';

interface Props { title: string; }
const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navItems = [
  { href: '/',             label: 'Resumen',     icon: 'home' },
  { href: '/proveedores',  label: 'Proveedores', icon: 'truck' },
  { href: '/partidarios',  label: 'Partidarios', icon: 'users' },
  { href: '/ventas',       label: 'Ventas',      icon: 'tag' },
  { href: '/trabajos',     label: 'Trabajos',    icon: 'clipboard' },
  { href: '/bajas',        label: 'Bajas',       icon: 'x' },
];
const current = Astro.url.pathname.replace(base, '') || '/';

const generatedDate = new Date(meta.generated_at);
const ageMs = Date.now() - generatedDate.getTime();
const ageH = Math.floor(ageMs / 3.6e6);
const ageD = Math.floor(ageH / 24);
const relAge =
  ageMs < 60_000 ? 'hace segundos'
  : ageMs < 3.6e6 ? `hace ${Math.floor(ageMs / 60_000)} min`
  : ageH < 24 ? `hace ${ageH}h`
  : ageD < 7 ? `hace ${ageD} d`
  : generatedDate.toLocaleDateString('es-BO', { day: '2-digit', month: 'short', year: '2-digit' });
const ageWarn = ageH > 24;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <title>{title} · Agropecuaria RBO</title>
    <style is:global>
      :root { font-family: 'Inter', system-ui, sans-serif; }
      @supports (font-variation-settings: normal) {
        :root { font-family: 'Inter var', system-ui, sans-serif; }
      }
    </style>
  </head>
  <body class="min-h-screen antialiased">
    <header class="sticky top-0 z-30 bg-white/90 backdrop-blur-md border-b border-stone-200/80 sticky-shadow">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between gap-4">
        <a href={base + '/'} class="flex items-center gap-3 group">
          <div class="w-9 h-9 rounded-lg bg-brand-600 text-white flex items-center justify-center font-bold text-sm shadow-sm group-hover:bg-brand-700 transition">RBO</div>
          <div class="hidden sm:block">
            <div class="text-[11px] uppercase tracking-wider text-brand-600 font-semibold leading-none">Agropecuaria</div>
            <div class="text-[15px] font-bold text-stone-900 leading-tight mt-0.5">Dashboards Ganaderos</div>
          </div>
        </a>

        <div class="flex items-center gap-2">
          <a
            href={base + '/buscar'}
            class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold border border-stone-200 bg-white text-stone-700 hover:border-brand-300 hover:bg-brand-50 hover:text-brand-900 transition"
            title="Buscar animal por chip"
          >
            <span class="text-base leading-none">🔍</span>
            <span class="hidden sm:inline">Buscar</span>
          </a>

          <!-- Botón "Sincronizar ahora" — solo funciona si sync-server.cmd está corriendo -->
          <button
            id="sync-now-btn"
            type="button"
            data-help-href={base + '/actualizar'}
            class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold border border-brand-300 bg-brand-50 text-brand-900 hover:bg-brand-100 transition disabled:opacity-60 disabled:cursor-not-allowed"
            title="Sincronizar SisGado ahora (necesita sync-server.cmd corriendo)"
          >
            <span id="sync-now-icon">⚡</span>
            <span id="sync-now-label" class="hidden sm:inline">Sincronizar</span>
          </button>

          <a
            href={base + '/actualizar'}
            class={`flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-medium border transition ${
              ageWarn
                ? 'border-amber-300 bg-amber-50 text-amber-800 hover:bg-amber-100'
                : 'border-stone-200 bg-stone-50 text-stone-600 hover:bg-stone-100'
            }`}
            title={`Última: ${generatedDate.toLocaleString('es-BO')}`}
          >
            <span class={`w-2 h-2 rounded-full ${ageWarn ? 'bg-amber-500' : 'bg-emerald-500'} animate-pulse`}></span>
            <span>Sync {relAge}</span>
            {ageWarn && <span class="ml-1">↻</span>}
          </a>
        </div>

        <!-- Modal simple para status del sync -->
        <div id="sync-modal" class="hidden fixed inset-0 bg-stone-900/60 backdrop-blur-sm z-50 items-center justify-center p-4">
          <div class="bg-white rounded-xl shadow-2xl max-w-md w-full p-6">
            <div class="flex items-center gap-3 mb-4">
              <span id="sync-modal-icon" class="text-3xl">⏳</span>
              <div>
                <h3 id="sync-modal-title" class="text-lg font-bold text-stone-900">Sincronizando</h3>
                <p id="sync-modal-sub" class="text-sm text-stone-500">Esto tarda ~1-2 minutos</p>
              </div>
            </div>
            <div id="sync-modal-log" class="bg-stone-900 text-stone-100 rounded-lg p-3 text-xs font-mono max-h-48 overflow-auto mb-4 hidden whitespace-pre-wrap"></div>
            <div class="flex items-center justify-end gap-2">
              <button id="sync-modal-close" class="px-4 py-2 rounded-lg text-sm font-semibold bg-stone-100 text-stone-700 hover:bg-stone-200 transition">Cerrar</button>
              <button id="sync-modal-reload" class="hidden px-4 py-2 rounded-lg text-sm font-semibold bg-brand-600 text-white hover:bg-brand-700 transition">Refrescar página</button>
            </div>
          </div>
        </div>

        <script is:inline>
        (function() {
          const SYNC_URL = 'http://localhost:3131';
          const btn = document.getElementById('sync-now-btn');
          const icon = document.getElementById('sync-now-icon');
          const label = document.getElementById('sync-now-label');
          const modal = document.getElementById('sync-modal');
          const modalIcon = document.getElementById('sync-modal-icon');
          const modalTitle = document.getElementById('sync-modal-title');
          const modalSub = document.getElementById('sync-modal-sub');
          const modalLog = document.getElementById('sync-modal-log');
          const modalClose = document.getElementById('sync-modal-close');
          const modalReload = document.getElementById('sync-modal-reload');
          if (!btn) return;

          let serverAvailable = false;

          function openModal() { modal.classList.remove('hidden'); modal.classList.add('flex'); }
          function closeModal() { modal.classList.add('hidden'); modal.classList.remove('flex'); modalLog.classList.add('hidden'); modalLog.textContent = ''; modalReload.classList.add('hidden'); }
          modalClose.addEventListener('click', closeModal);
          modalReload.addEventListener('click', () => location.reload());

          async function checkStatus() {
            try {
              const controller = new AbortController();
              setTimeout(() => controller.abort(), 2000);
              const r = await fetch(SYNC_URL + '/status', { signal: controller.signal });
              const data = await r.json();
              if (data.ok) {
                serverAvailable = true;
                btn.classList.remove('opacity-60');
                icon.textContent = '⚡';
                label.textContent = 'Sincronizar';
              }
            } catch (e) {
              serverAvailable = false;
              btn.classList.add('opacity-60');
              icon.textContent = '💤';
              label.textContent = 'Sync offline';
            }
          }

          async function doSync() {
            if (!serverAvailable) {
              // No hay server. Abrir la pagina de instrucciones
              location.href = btn.dataset.helpHref;
              return;
            }
            openModal();
            modalIcon.textContent = '⏳';
            modalTitle.textContent = 'Sincronizando SisGado';
            modalSub.textContent = 'Corriendo actualizar.cmd en tu PC... (~1-2 min)';
            btn.disabled = true;
            try {
              const r = await fetch(SYNC_URL + '/sync', { method: 'POST' });
              const data = await r.json();
              if (data.ok) {
                modalIcon.textContent = '✅';
                modalTitle.textContent = 'Sync completo';
                modalSub.textContent = 'Terminó en ' + data.duration_s + 's. El deploy tarda ~1 min más.';
                modalLog.textContent = (data.stdout || '').slice(-1500);
                modalLog.classList.remove('hidden');
                modalReload.classList.remove('hidden');
                // Auto reload en 60 segundos
                setTimeout(() => { if (!modal.classList.contains('hidden')) location.reload(); }, 60000);
              } else {
                modalIcon.textContent = '❌';
                modalTitle.textContent = 'Error en el sync';
                modalSub.textContent = data.error || 'Revisá el log';
                modalLog.textContent = (data.stderr || data.stdout || '');
                modalLog.classList.remove('hidden');
              }
            } catch (e) {
              modalIcon.textContent = '❌';
              modalTitle.textContent = 'No pude conectar al server';
              modalSub.textContent = e.message;
            }
            btn.disabled = false;
          }

          btn.addEventListener('click', doSync);
          checkStatus();
          setInterval(checkStatus, 30000);
        })();
        </script>
      </div>

      <nav class="max-w-7xl mx-auto px-2 sm:px-4 flex gap-1 overflow-x-auto pb-2">
        {navItems.map(item => {
          const href = base + item.href;
          const isActive = current === item.href || (item.href !== '/' && current.startsWith(item.href));
          return (
            <a
              href={href}
              class={`px-3.5 py-1.5 text-sm font-semibold rounded-lg transition whitespace-nowrap ${
                isActive
                  ? 'bg-gradient-to-b from-brand-500 to-brand-600 text-white shadow-sm shadow-brand-600/20'
                  : 'text-stone-600 hover:text-brand-800 hover:bg-brand-50'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-8">
      <slot />
    </main>

    <footer class="max-w-7xl mx-auto px-4 sm:px-6 py-8 text-xs text-stone-400 flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-stone-100 mt-8">
      <span>{meta.n_pesajes.toLocaleString('es-BO')} pesajes</span>
      <span>·</span>
      <span>{meta.n_animales.toLocaleString('es-BO')} animales</span>
      <span>·</span>
      <span>{meta.n_sesiones} sesiones</span>
      <span>·</span>
      <span>SisGado (Firebird) → Astro → GitHub Pages</span>
    </footer>
  </body>
</html>
